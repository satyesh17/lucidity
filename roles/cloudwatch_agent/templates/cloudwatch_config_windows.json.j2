{
  "agent": {
    "metrics_collection_interval": {{ metrics_collection_interval }},
    "run_as_user": "Local System"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "C:\\ProgramData\\Amazon\\AmazonCloudWatchAgent\\Logs\\amazon-cloudwatch-agent.log",
            "log_group_name": "{{ cloudwatch_log_group }}/windows",
            "log_stream_name": "{instance_id}-{ip_address}"
          }
        ]
      },
      "windows_events": {
        "collect_list": [
          {
            "event_name": "System",
            "event_levels": [
              "ERROR",
              "WARNING"
            ],
            "log_group_name": "{{ cloudwatch_log_group }}/windows-events",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "{{ cloudwatch_namespace }}",
    "metrics_collected": {
      "LogicalDisk": {
        "measurement": [
          {
            "name": "% Disk Time",
            "rename": "DiskTimePercent",
            "unit": "Percent"
          },
          {
            "name": "% Free Space",
            "rename": "DiskFreePercent",
            "unit": "Percent"
          },
          {
            "name": "Free Megabytes",
            "rename": "DiskFreeMB",
            "unit": "Megabytes"
          },
          {
            "name": "Disk Bytes/sec",
            "rename": "DiskBytesPerSec",
            "unit": "Bytes/Second"
          },
          {
            "name": "Avg. Disk Queue Length",
            "rename": "AvgDiskQueueLength",
            "unit": "Count"
          }
        ],
        "metrics_collection_interval": {{ metrics_collection_interval }},
        "resources": [
          "*"
        ]
      },
      "PhysicalDisk": {
        "measurement": [
          {
            "name": "Disk Read Bytes/sec",
            "rename": "DiskReadBytesPerSec",
            "unit": "Bytes/Second"
          },
          {
            "name": "Disk Write Bytes/sec",
            "rename": "DiskWriteBytesPerSec",
            "unit": "Bytes/Second"
          },
          {
            "name": "Disk Reads/sec",
            "rename": "DiskReadsPerSec",
            "unit": "Count/Second"
          },
          {
            "name": "Disk Writes/sec",
            "rename": "DiskWritesPerSec",
            "unit": "Count/Second"
          },
          {
            "name": "Avg. Disk sec/Read",
            "rename": "AvgDiskReadLatency",
            "unit": "Seconds"
          },
          {
            "name": "Avg. Disk sec/Write",
            "rename": "AvgDiskWriteLatency",
            "unit": "Seconds"
          }
        ],
        "metrics_collection_interval": {{ metrics_collection_interval }},
        "resources": [
          "*"
        ]
      },
      "Memory": {
        "measurement": [
          {
            "name": "% Committed Bytes In Use",
            "rename": "MemCommittedPercent",
            "unit": "Percent"
          }
        ],
        "metrics_collection_interval": {{ metrics_collection_interval }}
      }
    },
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "ImageId": "${aws:ImageId}",
      "InstanceType": "${aws:InstanceType}"
    }
  }
}
