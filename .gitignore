# Ansible
*.retry
.ansible/
ansible.log

# Logs
logs/*.log
*.log

# Temporary files
/tmp/
*.tmp
*.temp

# AWS credentials (never commit these)
.aws/
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Output files
output/metrics/*
output/reports/*
output/dashboards/*

# Keep directory structure but ignore contents
!output/metrics/.gitkeep
!output/reports/.gitkeep
!output/dashboards/.gitkeep
